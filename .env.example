# Abroad Application Hub - Free-tier Supabase Configuration
# Obtain these from your Supabase Project Settings -> API (Free Tier)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional server-only administrative key (NEVER expose to client browser)
# Used only for server-side maintenance, testing, or storage provisioning
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
