# AbroadAtlas - Free-tier Supabase Configuration
# Obtain these from your Supabase Project Settings -> API (Free Tier)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional server-only administrative key (NEVER expose to client browser)
# Used only for server-side maintenance, testing, or storage provisioning
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: free key for US program search in Discover (College Scorecard API)
# Get one at https://api.data.gov/signup/ - without it the rate-limited DEMO_KEY is used
COLLEGE_SCORECARD_API_KEY=

# Optional: Google Gemini API key. With it, Q&A answers and blueprints are written by the
# model from your sources; without it, they're built directly from the sources.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.5-flash-lite)
GEMINI_MODEL=

# Optional: daily email reminders (Resend + Vercel Cron)
# RESEND_API_KEY from https://resend.com (free tier). REMINDER_FROM_EMAIL must use a domain
# verified in Resend; "AbroadAtlas <onboarding@resend.dev>" only delivers to your own Resend address.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
# Any long random string; Vercel Cron sends it to authorise the daily job
CRON_SECRET=
# SUPABASE_SERVICE_ROLE_KEY (above) is required for reminders: the daily job reads every opted-in user's dates
# Optional: comma-separated emails allowed to use reminders (leave empty to allow everyone).
# Set it to your own address while sending through onboarding@resend.dev, which only delivers to you.
REMINDER_ALLOWED_EMAILS=

# Optional: per-user daily limits (defaults 30 / 20 / 20). They protect the shared Gemini key
# and outbound page fetching. Needs the 20261117000000_usage_limits_and_feedback.sql migration.
DAILY_AI_LIMIT=
DAILY_FETCH_LIMIT=
DAILY_FEEDBACK_LIMIT=

# Optional: comma-separated emails that can open the feedback inbox at /app/feedback.
# Reading feedback also needs SUPABASE_SERVICE_ROLE_KEY. Leave empty to hide the inbox.
ADMIN_EMAILS=
